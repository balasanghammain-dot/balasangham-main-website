# ==============================================================================
# Balasangham Kannur Website — Environment Configuration Example
# ==============================================================================
# Copy this file to .env or set these environment variables in your hosting provider.
# NEVER commit .env or any file containing real credentials or secrets to git.

# ------------------------------------------------------------------------------
# 1. PRIVATE SERVER-SIDE CONFIGURATION (NEVER expose to frontend/Vite client)
# ------------------------------------------------------------------------------

# Environment mode ('production' or 'development')
NODE_ENV=production

# Server listening port
PORT=3001

# Production website origin (used for CORS policy enforcement on the API server)
PRODUCTION_URL=https://balasanghamkannur.org

# Bcrypt hash of the admin portal password
# Generate using: node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 12))"
ADMIN_PASSWORD_HASH=

# Express session signing secret (must be a strong random string in production)
SESSION_SECRET=

# Cloudinary Private API Secret (used exclusively by server-side upload handler)
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 2. PUBLIC / CLIENT-SAFE CONFIGURATION (Browser-accessible via VITE_*)
# ------------------------------------------------------------------------------

# Cloudinary Account & Public Key (for media delivery and authenticated server upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=

# Firebase Client Web Configuration (Public Web API identifiers for Firestore)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
