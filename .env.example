# ==============================================================================
# Balasangham Kannur Website — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or set these in your deployment platform (Vercel / Firebase / Server).
# IMPORTANT: All VITE_* variables are bundled into browser assets.
# NEVER put private credentials (e.g. API secrets, service account keys) in VITE_* variables.

# Node environment & Server port
NODE_ENV=production
PORT=3001

# Public Firebase Client Configuration (Web SDK identifiers)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=balasangam-8e562.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=balasangam-8e562
VITE_FIREBASE_STORAGE_BUCKET=balasangam-8e562.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Cloudinary CDN Configuration
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key

# SERVER-SIDE ONLY PRIVATE SECRETS (Do NOT prefix with VITE_)
# Required for authenticated uploads and asset deletion
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Server Session & Admin Authentication Security
# Generate a strong 32+ character random string for production sessions
SESSION_SECRET=your-production-session-secret-min-32-chars
# Bcrypt hash of the admin password
ADMIN_PASSWORD_HASH=your-bcrypt-password-hash

# Optional: Comma-separated allowed CORS origins for Express API server
ALLOWED_ORIGINS=https://balasangam-8e562.web.app,https://balasangam-8e562.firebaseapp.com,https://balasanghamkannur.org
